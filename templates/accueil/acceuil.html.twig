{% extends 'base.html.twig' %}
{% block title %}Accueil{% endblock %}

{% block body %}
<h1>Bienvenue sur la page d'accueil!</h1>
<p>Voici quelques produits en vedette :</p>
<ul>
    {% for article in articles %}
        <li>
            <h2>{{ article.title }}</h2>
            <img src="{{ asset('img_articles/' ~ article.photo) }}" alt="Photo de l'article" width="200" height="200">
            <p>{{ article.content }}</p>
            <p>Prix : {{ article.price }} €</p>
            <p>Date de création : {{ article.createdAt|date('d/m/Y H:i') }}</p>
            {% if app.user %}
                <form method="POST" action="{{ path('app_cart_add_to_cart', {'id': article.id}) }}">
                <input type="number" min="1" name="quantity" value="1">
                <button type="submit">Ajouter au Panier avec Quantité</button>
                </form>
                <form method="POST" action="{{ path('get_command') }}" data-turbo="false">
                <input type="hidden" name="id" value="{{ article.id }}"> 
                <input type="hidden" name="quantity" value="1">
                    <button type="submit">Acheter</button>
                </form>
            {% else %}
                <button type ="button" disabled>Ajouter au Panier (Connectez-vous d'abord)</button>
                <button type ="button" disabled>Acheter (Connectez-vous d'abord)</button>
            {% endif %}
        
        </li>
    {% endfor %}
</ul>
{% endblock %}
