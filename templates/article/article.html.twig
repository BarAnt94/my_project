{% extends 'base.html.twig' %}

{% block title %}Hello ArticleController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    <table border="1" cellpadding="5" cellspacing="0">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titre</th>
            <th>Description</th>
            <th>Prix</th>
            <th>Date de création</th>
        </tr>
    </thead>
    <tbody>
        {% for article in articles %}
            <tr>
                <td>{{ article.id }}</td>
                <td>{{ article.title }}</td>
                <td>{{ article.content }}</td>
                <td>{{ article.price }} €</td>
                <td>{{ article.createdAt|date('d/m/Y H:i') }}</td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun article trouvé</td></tr>
        {% endfor %}
    </tbody>
</table>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>C:/Users/Antoine/my_project/src/Controller/ArticleController.php</code></li>
        <li>Your template at <code>C:/Users/Antoine/my_project/templates/article/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
