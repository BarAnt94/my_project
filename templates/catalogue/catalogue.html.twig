{% extends 'base.html.twig' %}

{% block title %}Hello CatalogueController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>
    <form method="get">
    <label>Catégorie :</label>
    <select name="category">
        <option value="">Toutes</option>
        <option value="Vin" {{ catalogues == 'Vin' ? 'selected' : '' }}>Vin</option>
        <option value="Spiritueux" {{ catalogues == 'Spiritueux' ? 'selected' : '' }}>Spiritueux</option> 
        <option value="Champagne" {{ catalogues == 'Champagne' ? 'selected' : '' }}>Champagne</option>
        <option value="Whisky" {{ catalogues == 'Whisky' ? 'selected' : '' }}>Whisky</option>
        <option value="Bière" {{ catalogues == 'Bière' ? 'selected' : '' }}>Bière</option>
    </select>

    <label>Prix maximum : {{ maxPrice}} €</label>
    <input type="range" name="maxPrice" min="0" max="1000" value="{{ maxPrice|default(1000) }}" oninput="this.nextElementSibling.value = this.value">
    <output>{{ maxPrice|default(1000) }}</output>
    <button>Filtrer</button>
</form>
<ul>
    {% for article in articles %}
        {{ article.title }}<br>
        <img src="{{ asset('img_articles/' ~ article.photo) }}" alt="Photo de l'article" width="200" height="200"></li> <li>{{ article.content }}</li> 
        <li>Date de création : {{ article.createdAt|date('d/m/Y H:i') }}</li>
        {{ article.price }} €
        {% if app.user %} 
            <form method="POST" action="{{ path('app_cart_add_to_cart', {'id': article.id}) }}">
            <input type="number" name="quantity" value="1"> <button type="submit">Ajouter au Panier avec Quantité</button> </form> 
            <form method="POST" action="{{ path('app_cart_purchase', {'id': article.id}) }}" data-turbo="false"> 
            <button type="submit">Acheter</button> </form> 
        {% else %}
            <button type ="button" disabled>Ajouter au Panier (Connectez-vous d'abord)</button> 
            <button type ="button" disabled>Acheter (Connectez-vous d'abord)</button> 
        {% endif %}
    {% else %}
        <li>Aucun article trouvé.</li>
    {% endfor %}
</ul>
</div>
{% endblock %}
