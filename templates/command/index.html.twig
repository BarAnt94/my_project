{% extends 'base.html.twig' %}

{% block title %}Hello CommandController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
{% if cart is empty %}
    <p>Aucun article trouvé</p>
{% else %}
    <table>
    <thead>
        <tr>
            <th>Titre</th>
            <th>Description</th>
            <th>Photo</th>
            <th>Prix</th>
            <th>Quantité</th>
        </tr>
    </thead>
     {% for item in items %}
    <tbody>
        <tr>
            <td>{{ item.article.title }}</td>
            <td>{{ item.article.content }}</td>
            <td><img src="{{ asset('img_articles/' ~ item.article.photo) }}" alt="Photo de l'article" width="200" height="200"></td>
            <td>{{ item.article.price }} €</td>
            <td>{{ item.quantity }}</td>
        </tr>
    </tbody>
    <tfoot>
        <tr>
            <td colspan="4">Total</td>
            <td>{{ total }} €</td>
            <td></td>
        </tr>
    </tfoot>
    </table>
    {% endfor %}
    {% endif %}
    {% if adresses is empty %}
    <p>Vous n'avez aucune adresse enregistrée.</p>
    <a href="{{ path('app_adress_new') }}">Ajouter une adresse</a>
    {% else %}
        <form method="POST" action="{{ path('command_purchase') }}" data-turbo="false">
        <label for="address">Sélectionnez une adresse de livraison :</label><br>
        <select name="addressId" id="address">
        <option value="">Aucune adresse de livraison sélectionnée</option>
        {% for adresse in adresses %}
            <option value="{{ adresse.id }}">{{ adresse.title }} - {{ adresse.adress }}, {{ adresse.city }}</option>
        {% endfor %}
        </select>
        <label for="secondaryAddress">Sélectionnez une adresse de facturation (optionnel) :</label>
        <select name="secondaryAddressId" id="secondaryAddress">
        <option value="">Aucune adresse de facturation</option>
        {% for adresse in adresses %}
            <option value="{{ adresse.id }}">{{ adresse.title }} - {{ adresse.adress }}, {{ adresse.city }}</option>
        {% endfor %}
        </select>
        <button type="submit">Confirmer la commande</button><br>
        </form>
        <form method="POST" action="{{ path('command_cancel') }}" data-turbo="false">
        <label for="cancel">Annuler la commande :</label>
        <button type="submit" name="cancel" value="true">Annuler</button>
        </form>
    {% endif %}
</table>
</div>
{% endblock %}
