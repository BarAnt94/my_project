{% extends 'base.html.twig' %}

{% block title %}Hello CommandController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
{% if articles is empty %}
    <p>Aucun article trouvé</p>
{% else %}
    <table>
    <thead>
        <tr>
            <th>ID</th>
            <th>Titre</th>
            <th>Description</th>
            <th>Photo</th>
            <th>Prix</th>
        </tr>
    </thead>
     {% for article in articles %}
    <tbody>
        <tr>
            <td>{{ article.id }}</td>
            <td>{{ article.title }}</td>
            <td>{{ article.content }}</td>
            <td><img src="{{ asset('img_articles/' ~ article.photo) }}" alt="Photo de l'article" width="200" height="200"></td>
            <td>{{ article.price }} €</td>
        </tr>
    </tbody>
    </table>
    {% endfor %}
    {% endif %}
    {% if adresses is empty %}
    <p>Vous n'avez aucune adresse enregistrée.</p>
    <a href="{{ path('app_adress_new') }}">Ajouter une adresse</a>
    {% else %}
        <form method="POST" action="{{ path('app_cart_purchase') }}" data-turbo="false">
        <label for="address">Sélectionnez une adresse de livraison :</label>
        <select name="addressId" id="address">
        {% for adresse in adresses %}
            <option value="{{ adresse.id }}">{{ adresse.title }} - {{ adresse.adress }}, {{ adresse.city }}</option>
        {% endfor %}
    </select>
    <button type="submit">Confirmer la commande</button>
</form>
    {% endif %}
</table>
</div>
{% endblock %}
