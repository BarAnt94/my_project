{% extends 'base.html.twig' %}

{% block title %}Hello OrderItemController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Vos Commandes</h1>
    <table>
       <table>
    <thead>
        <tr>
            <th>Photo</th>
            <th>Article</th>
            <th>Prix</th>
            <th>Quantité</th>
            <th>Commande</th>
            <th>Référence</th>
            <th>Date</th>
        </tr>
    </thead>

    <tbody>
        {% for order in orders %}
            {% for item in order.orderItems %}
                <tr>
                    <td><img src="{{ asset('img_articles/' ~ item.article.photo) }}" alt="{{ item.article.title }}" width="100"></td>
                    <td>{{ item.article.title }}</td>
                    <td>{{ item.article.price }}</td>
                    <td>{{ item.quantity }}</td>
                    <td>#{{ order.orderNumber }}</td>
                    <td>{{ order.reference }}</td>
                    <td>{{ order.date|date('Y-m-d') }}</td>
                </tr>
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="7">Aucune commande trouvée</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
    <a href="{{ path('app_user_profile') }}">Retour au profil</a>
</div>
{% endblock %}
