{% extends 'base.html.twig' %}

{% block title %}Search{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Résultats de la recherche pour "{{ query }}"</h1>
    {% if results is empty %}
        <p>Aucun résultat trouvé.</p>
    {% else %}
        <ul>
            {% for article in results %}
                <li>
                    <h2>{{ article.title }}</h2>
                    <img src="{{ asset('img_articles/' ~ article.photo) }}" alt="Photo de l'article" width="200" height="200">
                    <p>{{ article.content }}</p>
                    <p>Prix : {{ article.price }} €</p>
                    <p>Date de création : {{ article.createdAt|date('d/m/Y H:i') }}</p>
                    {% if app.user %}
                    <form method="POST" action="{{ path('app_cart_add_to_cart', {'id': article.id}) }}">
                    <input type="number" name="quantity" value="1">
                    <button type="submit">Ajouter au Panier avec Quantité</button>
                    </form>
                    <form method="POST" action="{{ path('command', {'id': article.id}) }}" data-turbo="false">
                        <input type="hidden" name="id" value="{{ article.id }}">
                        <input type="hidden" name="quantity" value="1">
                        <button type="submit">Acheter</button>
                    </form>
                    {% else %}
                    <button type ="button" disabled>Ajouter au Panier (Connectez-vous d'abord)</button>
                    <button type ="button" disabled>Acheter (Connectez-vous d'abord)</button>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
